# SafeVision AI – environment configuration
#
# Copy to .env and fill in the values for your environment.

# Supabase (auth + database)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# SafeVision AI detection service (FastAPI + YOLO)
# Local development: http://127.0.0.1:8000
# Production: the deployed HTTPS URL of your detection service.
VITE_AI_SERVICE_URL=http://127.0.0.1:8000
